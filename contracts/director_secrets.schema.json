{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aiworld/schemas/director-secrets-0.1.json",
  "title": "AIWorld DirectorSecrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "world_id", "secrets", "plot_seeds"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "world_id": { "$ref": "#/$defs/id" },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner_actor_id", "statement", "importance", "reveal_conditions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "owner_actor_id": { "$ref": "#/$defs/id" },
          "statement": { "type": "string", "minLength": 4, "maxLength": 300 },
          "importance": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "reveal_conditions": {
            "type": "array",
            "maxItems": 8,
            "items": { "enum": ["high_trust", "direct_witness", "quest_reveal", "director_event", "owner_confession"] }
          }
        }
      }
    },
    "plot_seeds": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "premise", "involved_actor_ids", "severity", "earliest_day"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "premise": { "type": "string", "minLength": 8, "maxLength": 300 },
          "involved_actor_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "severity": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "earliest_day": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,47}$" }
  }
}
