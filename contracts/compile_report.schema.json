{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aiworld/schemas/compile-report-0.1.json",
  "title": "AIWorld CompileReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compile_id", "status", "world_generator_version", "prompt_version", "mode", "model", "input", "attempts", "validation_errors", "output", "started_at_utc", "finished_at_utc", "duration_ms"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "compile_id": { "type": "string", "pattern": "^compile_[a-zA-Z0-9_-]{8,72}$" },
    "status": { "enum": ["success", "failure"] },
    "world_generator_version": { "type": "string", "pattern": "^worldgen-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "prompt_version": { "type": "string", "pattern": "^world-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mode": { "enum": ["mock", "live"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "temperature"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lore_sha256", "theme_sha256", "seed"],
      "properties": {
        "lore_sha256": { "$ref": "#/$defs/hash" },
        "theme_sha256": { "$ref": "#/$defs/hash" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "attempts": { "type": "integer", "minimum": 1, "maximum": 2 },
    "validation_errors": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_spec_sha256", "director_secrets_sha256"],
      "properties": {
        "world_spec_sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "director_secrets_sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "finished_at_utc": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
