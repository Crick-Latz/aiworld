{
  "schema_version": "0.1",
  "mode": "demo",
  "features": {
    "live_ai": false,
    "generated_art": false,
    "chunk_streaming": false,
    "combat": false,
    "timeline_branching": false
  },
  "simulation": {
    "semantic_tick_ms": 1000,
    "game_minutes_per_tick": 1,
    "max_commands_per_tick": 100,
    "max_actor_state_transitions_per_tick": 2
  },
  "map": {
    "generator_version": "mapgen-0.1.0",
    "cell_size_m": 1.0,
    "level_height_m": 0.5,
    "width_tiles": 64,
    "depth_tiles": 64,
    "max_visual_level": 3,
    "max_generation_attempts": 8,
    "poi_min_manhattan_distance": 10,
    "edge_padding_tiles": 4,
    "walkable_ratio_min": 0.65,
    "walkable_ratio_max": 0.82,
    "noise": {
      "elevation_frequency": 0.035,
      "elevation_octaves": 4,
      "moisture_frequency": 0.045,
      "moisture_octaves": 3
    }
  },
  "camera": {
    "mode": "orthographic_isometric",
    "orthogonal_size": 20.0,
    "offset": { "x": 12.0, "y": 12.0, "z": 12.0 },
    "near": 0.1,
    "far": 200.0,
    "follow_smoothing_seconds": 0.18,
    "zoom_min": 12.0,
    "zoom_max": 30.0,
    "zoom_step": 2.0,
    "rotation_step_degrees": 90.0,
    "rotation_tween_seconds": 0.25
  },
  "actors": {
    "player_speed_m_per_second": 4.5,
    "npc_speed_m_per_second": 2.8,
    "interaction_radius_m": 1.75,
    "gravity_m_per_second_squared": 20.0,
    "floor_snap_length_m": 0.25,
    "stuck_repath_after_ms": 3000,
    "max_repath_attempts": 3,
    "max_path_nodes": 256
  },
  "ai": {
    "gateway_base_url": "http://127.0.0.1:3210",
    "request_timeout_ms": 8000,
    "global_concurrency": 2,
    "requests_per_minute": 6,
    "session_request_limit": 60,
    "actor_cooldown_seconds": 30,
    "idempotency_cache_seconds": 600
  },
  "save": {
    "autosave_interval_seconds": 60,
    "minimum_save_gap_seconds": 10,
    "keep_previous_state": true,
    "event_log_flush_interval_seconds": 5
  },
  "diagnostics": {
    "level": "info",
    "file_max_bytes": 10485760,
    "file_keep_count": 5,
    "show_debug_overlay": false
  }
}
